# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional SMTP Configuration for transactional & welcome emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Uchiro Store <noreply@uchiro.store>"

# JWT Authentication Secret Key
# REQUIRED in production (Vercel/Railway) -- the app will refuse to boot without
# this set outside of local development. Generate a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# OPTIONAL: Firestore-backed persistence for products/orders/users.
# Without this, data is stored in a local JSON file. On Vercel that file lives
# in /tmp, which is WIPED between serverless cold starts -- so admin-added
# products/orders can randomly disappear. Set this to make data persist:
#   1. Firebase Console -> Project Settings -> Service Accounts
#      -> Generate new private key (downloads a JSON file)
#   2. Paste that JSON file's full contents here as one line/string
# Not needed for local dev or for Railway (which has a persistent disk).
FIREBASE_SERVICE_ACCOUNT=

# --- Telegram bots ---
# Customer-facing storefront bot (@uchiro_storeV2_bot or similar).
# Get this from @BotFather. Never commit a real value here.
TELEGRAM_BOT_TOKEN=

# Separate admin-only bot for order/topup approvals (@uchiro_v2_admin_bot or similar).
# Optional: if unset, admin alerts fall back to TELEGRAM_BOT_TOKEN + TELEGRAM_ADMIN_CHAT_IDS.
TELEGRAM_ADMIN_BOT_TOKEN=

# Comma-separated Telegram user IDs who should receive admin alerts, e.g. "123456789,987654321"
TELEGRAM_ADMIN_CHAT_IDS=

# Public channel used for announcements/live-activity links, e.g. "https://t.me/uchirostore"
TELEGRAM_CHANNEL_URL=

# --- Payment providers ---
# KHPay (khpay.site) API key. Get this from your KHPay merchant dashboard.
KHPAY_API_KEY=

# ABA PayWay static payment link (e.g. https://link.payway.com.kh/ABAPAYxxxxxxx)
ABA_PAYWAY_LINK=

# Public site URL (used for share links, email links, and callback URLs)
SITE_URL="https://www.uchiro.store"

# --- Scheduled backups ---
# Secures the /api/cron/auto-backup endpoint so only Vercel's own cron
# scheduler (or a logged-in admin) can trigger it. Set this to any random
# string of 16+ characters in Vercel's Environment Variables -- Vercel
# automatically sends it back as a Bearer token when the cron job runs.
CRON_SECRET=
