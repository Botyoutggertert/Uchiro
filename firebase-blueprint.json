{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile storing authentication linkage, balance, rank, and settings",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Firebase Auth user UID"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User account email address"
        },
        "username": {
          "type": "string",
          "description": "Unique immutable gamer tag / handle",
          "pattern": "^[a-z0-9_]{3,20}$",
          "minLength": 3,
          "maxLength": 20
        },
        "avatarUrl": {
          "type": "string",
          "description": "User avatar image URL",
          "maxLength": 1024
        },
        "balanceUSD": {
          "type": "number",
          "description": "Current store wallet balance in USD"
        },
        "totalSpentUSD": {
          "type": "number",
          "description": "Total USD spent for VIP rank progress"
        },
        "isResellerUnlocked": {
          "type": "boolean",
          "description": "Whether reseller pricing tier is unlocked"
        },
        "isBanned": {
          "type": "boolean",
          "description": "Whether the user account has been banned by an admin"
        },
        "bannedReason": {
          "type": "string",
          "description": "Reason for account suspension"
        },
        "role": {
          "type": "string",
          "enum": ["customer", "reseller", "admin"],
          "description": "Customer role classification"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of account creation"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of last profile update"
        }
      },
      "required": ["id", "email", "username", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Stores individual user account profile and wallet data"
    },
    "/usernames/{username}": {
      "description": "Public username-to-email mapping for username login lookup"
    }
  }
}
