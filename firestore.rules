rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isSignedIn() && (
        ('email' in request.auth.token && request.auth.token.email == 'youtgg13@gmail.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'email', 'username', 'createdAt', 'updatedAt']) &&
        data.id is string &&
        data.email is string && data.email.size() <= 256 &&
        data.username is string && data.username.size() <= 64 &&
        (!('referralCode' in data) || (data.referralCode is string && data.referralCode.size() <= 64)) &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
        (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 2048)) &&
        (!('balanceUSD' in data) || (data.balanceUSD is number && data.balanceUSD >= 0)) &&
        (!('totalSpentUSD' in data) || (data.totalSpentUSD is number && data.totalSpentUSD >= 0)) &&
        (!('isResellerUnlocked' in data) || data.isResellerUnlocked is bool) &&
        (!('isBanned' in data) || data.isBanned is bool) &&
        (!('bannedReason' in data) || (data.bannedReason is string && data.bannedReason.size() <= 256)) &&
        (!('role' in data) || (data.role is string && data.role in ['customer', 'reseller', 'admin']));
    }

    // User profiles & wallet data
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin() || (isSignedIn() && resource.data.id == request.auth.uid);
      allow create, update: if (isOwner(userId) || isAdmin()) && isValidId(userId);
      allow delete: if isAdmin();
    }

    // Public username lookup for login resolution
    match /usernames/{username} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Health check collection for boot validation
    match /test/{docId} {
      allow read: if true;
    }
  }
}
